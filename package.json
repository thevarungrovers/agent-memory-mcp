{
  "name": "agent-memory-mcp",
  "version": "1.0.0",
  "description": "Local MCP server that acts as a persistent memory database for coding agents. Stores bugs, patterns, and learnings that agents can query and write to.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "agent-memory-mcp": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "setup": "tsx src/setup.ts",
    "postbuild": "echo '\n Run \"npm run setup\" to configure storage (local or Google Drive backup).\n'",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "agent-memory",
    "coding-agent",
    "sqlite",
    "cursor",
    "codex",
    "claude"
  ],
  "author": "Varun Grover",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^11.9.1",
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.17",
    "tsup": "^8.4.0",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
