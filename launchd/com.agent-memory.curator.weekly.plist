<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Weekly whole corpus sweep, Sunday 23:30 local.

  TEMPLATE. The __PROJECT_ROOT__ and __NODE_BIN__ tokens are substituted by
  scripts/install-curator.sh; do not copy this file into LaunchAgents by hand.

  The sweep takes the entries that have waited longest, never-curated first, corpus
  wide. Ordering by staleness is what lets it terminate: an earlier version walked one
  area per run ordered by most recently updated, which re-picked the same rows on every
  visit and left everything below the per run cap unreachable.

  For an existing store, run scripts/backfill-curation.sh once first. The nightly pass
  only ever sees what changed since it last ran, so a store with history carries a
  backlog neither job would otherwise reach.

  XML forbids a double hyphen inside a comment, so there are none here.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.agent-memory.curator.weekly</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__PROJECT_ROOT__/scripts/run-curator.sh</string>
        <string>sweep</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        <key>AGENT_MEMORY_NODE</key>
        <string>__NODE_BIN__</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__PROJECT_ROOT__</string>

    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Weekday</key>
            <integer>0</integer>
            <key>Hour</key>
            <integer>23</integer>
            <key>Minute</key>
            <integer>30</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__PROJECT_ROOT__/curator/state/logs/weekly.launchd.log</string>
    <key>StandardErrorPath</key>
    <string>__PROJECT_ROOT__/curator/state/logs/weekly.launchd.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
    <key>Nice</key>
    <integer>5</integer>
</dict>
</plist>
