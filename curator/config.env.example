# Copy to config.env (chmod 600). Sourced by scripts/run-curator.sh.
# Everything here is optional; the curator runs without any of it.

# Discord webhook for alerts. Left empty, notification is a silent no-op.
# The curator only posts when something changed or needs attention — a message that
# arrives nightly saying "nothing notable" stops being read within a fortnight.
CURATOR_DISCORD_WEBHOOK=

# Extra flags for `agent-memory curate`. The useful one while you are still deciding
# whether to trust it: --dry-run records every decision as a proposal and changes
# nothing.
# CURATOR_EXTRA_ARGS=--dry-run

# Override the model. Defaults to claude-opus-5.
# CURATOR_MODEL=claude-opus-5
