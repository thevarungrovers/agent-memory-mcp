# Copy to config.env (chmod 600). Sourced by scripts/run-curator.sh.
# Everything here is optional; the curator runs without any of it.
#
# This file is read by `.`, so QUOTE ANY VALUE CONTAINING A SPACE. Unquoted, bash
# assigns up to the space and runs the rest of the line as a command:
#   WRONG:  CURATOR_EXTRA_ARGS=--limit 10      <- runs `10`
#   RIGHT:  CURATOR_EXTRA_ARGS="--limit 10"

# Discord webhook. Left empty, every notification is a silent no-op — nothing warns
# and nothing fails. A run reports itself at the end either way.
CURATOR_DISCORD_WEBHOOK=

# How much of that you want to hear:
#   all      every run, success or failure (the default)
#   changes  only runs that changed something or raised a flag, plus every failure
#   errors   only failures
#   off      nothing
# Failures are always announced at 'all', 'changes' and 'errors', including the
# preflight ones that happen before node is involved.
# CURATOR_NOTIFY_LEVEL=all

# Extra flags for `agent-memory curate`.
#
# --dry-run records every decision as a proposal and changes nothing. Useful for a few
# passes on a fresh install, to read its judgement before trusting it unattended. Do
# not leave it here permanently: a dry run still exits 0 and still says `ok`, so the
# only sign is the scorecard reading `0 changed, N to review` every single night.
# CURATOR_EXTRA_ARGS=--dry-run

# Override the model. Defaults to claude-opus-5.
# CURATOR_MODEL=claude-opus-5
